<!-- First run of the Store build (no installer of ours there): pick a theme and "start with
     Windows", or, when settings are already there, keep or clear them. Same card as the installer. -->
<Window x:Class="MiniPlayer.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MiniPlayer.Views"
        xmlns:s="clr-namespace:MiniPlayer.Services"
        Title="{x:Static s:AppInfo.Name}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="800" SizeToContent="Height" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#16141E">
    <Window.Resources>
        <ResourceDictionary Source="SetupStyles.xaml" />
    </Window.Resources>

    <Grid Margin="20,16,20,28">
        <Border CornerRadius="14" Background="#FBF7FE">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.5" /></Border.Effect>
        </Border>
        <Grid v:RoundedClip.CornerRadius="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="Hero" Height="280" Stretch="UniformToFill" MouseLeftButtonDown="OnDrag" RenderOptions.BitmapScalingMode="HighQuality" />

            <Border Grid.Row="1" Padding="26,20,26,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F6F1FD" Offset="0" />
                        <GradientStop Color="#FDF2F8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="LeadText" Style="{StaticResource Lead}" />

                    <StackPanel x:Name="OldPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <WrapPanel x:Name="Chips" Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="KeepChoice" Style="{StaticResource Choice}" GroupName="old" IsChecked="True" Tag="#7C3AED" Margin="0,0,6,0" Checked="OnChoice">
                                <StackPanel><TextBlock x:Name="KeepText" FontWeight="SemiBold" /><TextBlock x:Name="KeepHint" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FreshChoice" Style="{StaticResource Choice}" GroupName="old" Tag="#E11D48" Margin="6,0,0,0" Checked="OnChoice">
                                <StackPanel><TextBlock x:Name="FreshText" FontWeight="SemiBold" /><TextBlock x:Name="FreshHint" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <CheckBox x:Name="BackupBox" IsChecked="True" Margin="4,10,0,0" Visibility="Collapsed" VerticalContentAlignment="Center">
                            <TextBlock x:Name="BackupText" FontSize="13" />
                        </CheckBox>
                    </StackPanel>

                    <StackPanel x:Name="ThemePanel">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="ThemeHint" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" />
                            <TextBlock x:Name="ThemeTitle" FontWeight="SemiBold" />
                        </DockPanel>
                        <ListBox x:Name="ThemeList" Style="{StaticResource Themes}" Margin="0,0,0,10" />
                    </StackPanel>

                    <DockPanel Margin="0,4,0,0">
                        <Button x:Name="GoButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="OnGo" IsDefault="True" VerticalAlignment="Center" />
                        <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Left" MinWidth="320" Margin="0,0,16,0">
                            <StackPanel><TextBlock x:Name="StartupText" FontWeight="SemiBold" /><TextBlock x:Name="StartupHint" FontSize="12.5" Foreground="{StaticResource Muted}" /></StackPanel>
                        </CheckBox>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
