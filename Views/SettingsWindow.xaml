<Window x:Class="MiniPlayer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — MiniPlayer" Width="860" Height="600" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- A settings "card" -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#22808080" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <ListBox x:Name="Nav" Margin="8,12,4,12" BorderThickness="0" Background="Transparent"
                 SelectionChanged="OnNavChanged">
            <ListBoxItem Tag="General" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" /><TextBlock Text="Geral" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Appearance" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE790;" /><TextBlock Text="Aparência" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Taskbar" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE90E;" /><TextBlock Text="Barra de tarefas" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Updates" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE895;" /><TextBlock Text="Atualizações" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="About" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE946;" /><TextBlock Text="Sobre" /></StackPanel>
            </ListBoxItem>
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,16,28,28">

                <!-- ===================== GERAL ===================== -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Geral" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Onde mostrar o player" FontWeight="SemiBold" />
                            <RadioButton x:Name="ModeFloating" Content="Player flutuante" Margin="0,8,0,0" Checked="OnModeChecked" />
                            <RadioButton x:Name="ModeTaskbar" Content="Na barra de tarefas" Margin="0,4,0,0" Checked="OnModeChecked" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Fixar o player no topo das outras janelas" IsChecked="{Binding PinOnTop}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Mostrar letra sincronizada" IsChecked="{Binding ShowLyrics}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="No player flutuante aparece embaixo; na barra, no lugar do artista. Envia título e artista para lrclib.net." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutoStartBox" Content="Iniciar com o Windows" Click="OnAutoStartClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== APARÊNCIA ===================== -->
                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Aparência" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tema" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="ThemeList" Height="300" SelectionChanged="OnThemeSelected"
                                 MouseDoubleClick="OnThemeDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <!-- Swatch: theme background with accent dot -->
                                        <Grid Width="34" Height="34" Margin="0,0,10,0">
                                            <Border CornerRadius="6" Background="{Binding Background}" BorderBrush="#33808080" BorderThickness="1" />
                                            <Ellipse Width="12" Height="12" Fill="{Binding Accent}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Prévia" Opacity="0.7" Margin="0,0,0,6" />
                            <!-- Live preview: theme resources are set on PreviewHost only -->
                            <Border x:Name="PreviewHost" Padding="16" CornerRadius="8" Background="#22808080" HorizontalAlignment="Stretch">
                              <!-- Shrinks the preview when the window is narrow; never enlarges it -->
                              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <Grid x:Name="Preview" Width="360" Height="129" IsHitTestVisible="False"
                                      TextElement.Foreground="{DynamicResource ThemeForeground}"
                                      TextElement.FontFamily="{DynamicResource ThemeFont}">
                                    <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeBackground}"
                                            Effect="{DynamicResource ThemeShadow}" />
                                    <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Visibility="{DynamicResource ThemeCoverBackdropVisibility}"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverBackdrop}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeImageBrush}" />
                                    <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeOverlay}"
                                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="{DynamicResource ThemeBorderThickness}" />

                                    <Grid Margin="14,10,10,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="84" Height="84" Margin="0,0,12,0">
                                                <Border CornerRadius="{DynamicResource ThemeCoverRadius}" Background="{DynamicResource ThemeTrack}">
                                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="28" Opacity="0.5"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border CornerRadius="{DynamicResource ThemeCoverRadius}"
                                                        Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid>
                                                    <StackPanel Margin="0,0,70,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource ThemeSecondary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource PinButton}" FontSize="12" Width="22" Height="22" />
                                                        <Button Style="{StaticResource LyricsButton}" Content="&#xE720;" FontSize="12" Width="22" Height="22" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="22" Height="22" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="-6,6,0,0">
                                                    <Button Style="{StaticResource ShuffleButton}" Content="&#xE8B1;" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" />
                                                    <Button Style="{StaticResource IconButton}" Content="{Binding PlayGlyph}" FontSize="20" Width="44" Height="40" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" />
                                                    <Button Style="{StaticResource RepeatButton}" Content="{Binding RepeatGlyph}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,10,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="1:23" FontSize="11" Foreground="{DynamicResource ThemeSecondary}" MinWidth="34" />
                                            <ProgressBar Grid.Column="1" Style="{StaticResource ThinProgress}" Height="4" Value="0.4" Margin="6,0" />
                                            <TextBlock Grid.Column="2" Text="3:45" FontSize="11" Foreground="{DynamicResource ThemeSecondary}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                              </Viewbox>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="UseThemeButton" Content="Usar este tema" Style="{DynamicResource AccentButtonStyle}"
                                        Padding="14,6" Click="OnUseTheme" />
                                <TextBlock x:Name="ThemeInUse" Text="✓ Tema em uso" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Abrir pasta de temas" Padding="12,5" Click="OnOpenThemes" />
                                <Button Content="Recarregar" Padding="12,5" Margin="8,0,0,0" Click="OnReloadThemes" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Temas são arquivos .json na pasta de temas (veja exemplo-oceano.json). Salvar o arquivo atualiza na hora." />
                            <TextBlock x:Name="ThemeErrors" Style="{StaticResource Hint}" Foreground="#E0A030" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tamanho do player flutuante" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Text="Zoom" VerticalAlignment="Center" Width="60" />
                                <Slider x:Name="ZoomSlider" Minimum="70" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="OnZoomChanged" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Também: Ctrl + roda do mouse sobre o player. Arraste as bordas para mudar o formato (mini, normal, retrato)." />
                            <Button Content="Restaurar tamanho padrão" Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Click="OnResetSize" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== BARRA DE TAREFAS ===================== -->
                <StackPanel x:Name="PageTaskbar" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Barra de tarefas" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tela" FontWeight="SemiBold" />
                            <ComboBox x:Name="ScreenBox" Margin="0,8,0,0" MinWidth="240" HorizontalAlignment="Left"
                                      DisplayMemberPath="Label" SelectionChanged="OnScreenChanged" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Com mais de um monitor, ative &quot;Mostrar barra de tarefas em todas as telas&quot; no Windows." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Ocultar quando nada estiver tocando" IsChecked="{Binding AutoHideWhenIdle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Some após 3 s sem mídia ou 30 s pausado; volta quando algo toca." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Posição" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="Arraste o título na barra para mover o player para os lados." />
                            <Button Content="Voltar para perto do relógio" Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Click="OnResetTaskbarPosition" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== ATUALIZAÇÕES ===================== -->
                <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Atualizações" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="CheckButton" Content="Verificar agora" Padding="12,5" Click="OnCheckUpdates" />
                                <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="KeepUpdatedBox" Content="Manter atualizado" Click="OnKeepUpdatedClick" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Ao abrir, instala a nova versão sozinho. Com o app aberto, baixa em segundo plano e instala na próxima abertura (sem interromper a música)." />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,12,0,0">
                        <Hyperlink Click="OnOpenReleases">Ver novidades de cada versão no GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="NotInstalledHint" Style="{StaticResource Hint}" Margin="0,12,0,0" Visibility="Collapsed"
                               Text="Esta cópia não foi instalada pelo instalador, por isso não se atualiza sozinha. Use o MiniPlayer-win-Setup.exe." />
                </StackPanel>

                <!-- ===================== SOBRE ===================== -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Sobre" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MiniPlayer" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutVersion" Opacity="0.7" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Mostra e controla a música tocando no navegador (YouTube, Spotify, SoundCloud, Deezer…) usando os controles de mídia do Windows." />
                            <TextBlock Margin="0,10,0,0">
                                <Hyperlink Click="OnOpenRepo">github.com/williamanjo/MiniPlayer</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Abrir pasta de configurações" Padding="12,5" Click="OnOpenSettingsFolder" />
                        <Button Content="Abrir pasta de temas" Padding="12,5" Margin="8,0,0,0" Click="OnOpenThemes" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
