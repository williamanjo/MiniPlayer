<Window x:Class="MiniPlayer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniPlayer.Localization"
        Title="{l:Tr settings_window_title}" Width="860" Height="600" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- A settings "card" -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#22808080" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <ListBox x:Name="Nav" Margin="8,12,4,12" BorderThickness="0" Background="Transparent"
                 SelectionChanged="OnNavChanged">
            <ListBoxItem Tag="General" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" /><TextBlock Text="{l:Tr nav_general}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Appearance" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE790;" /><TextBlock Text="{l:Tr nav_appearance}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Controls" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE765;" /><TextBlock Text="{l:Tr nav_controls}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Automation" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE945;" /><TextBlock Text="{l:Tr nav_automation}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="History" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;" /><TextBlock Text="{l:Tr nav_history}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Stream" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE93E;" /><TextBlock Text="{l:Tr nav_stream}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Taskbar" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE90E;" /><TextBlock Text="{l:Tr nav_taskbar}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Updates" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE895;" /><TextBlock Text="{l:Tr nav_updates}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="About" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE946;" /><TextBlock Text="{l:Tr nav_about}" /></StackPanel>
            </ListBoxItem>
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,16,28,28">

                <!-- ===================== GERAL ===================== -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_general}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Tr language_title}" FontWeight="SemiBold" VerticalAlignment="Center" Width="170" />
                            <ComboBox x:Name="LanguageBox" MinWidth="260" SelectionChanged="OnLanguageChanged">
                                <ComboBoxItem Tag="auto" Content="{l:Tr language_auto}" />
                                <ComboBoxItem Tag="en" Content="{l:Tr language_english}" />
                                <ComboBoxItem Tag="pt-BR" Content="{l:Tr language_portuguese}" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr general_mode_title}" FontWeight="SemiBold" />
                            <RadioButton x:Name="ModeFloating" Content="{l:Tr general_mode_floating}" Margin="0,8,0,0" Checked="OnModeChecked" />
                            <RadioButton x:Name="ModeTaskbar" Content="{l:Tr general_mode_taskbar}" Margin="0,4,0,0" Checked="OnModeChecked" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="{l:Tr general_pin}" IsChecked="{Binding PinOnTop}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="{l:Tr general_lyrics}" IsChecked="{Binding ShowLyrics}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr lyrics_hint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr sleep_title}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr sleep_hint}" />
                            <WrapPanel x:Name="SleepButtons" Margin="0,10,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="SleepStatus" VerticalAlignment="Center" />
                                <Button x:Name="SleepCancel" Content="{l:Tr common_cancel}" Padding="10,3" Margin="12,0,0,0" Click="OnSleepCancel" />
                            </StackPanel>
                            <CheckBox x:Name="SleepFadeBox" Content="{l:Tr sleep_fade}" Margin="0,10,0,0"
                                      Click="OnSleepFadeClick" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutoStartBox" Content="{l:Tr general_autostart}" Click="OnAutoStartClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== APARÊNCIA ===================== -->
                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_appearance}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr theme}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="ThemeList" Height="300" SelectionChanged="OnThemeSelected"
                                 MouseDoubleClick="OnThemeDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <!-- Swatch: theme background with accent dot -->
                                        <Grid Width="34" Height="34" Margin="0,0,10,0">
                                            <Border CornerRadius="6" Background="{Binding Background}" BorderBrush="#33808080" BorderThickness="1" />
                                            <Ellipse Width="12" Height="12" Fill="{Binding Accent}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{l:Tr theme_preview}" Opacity="0.7" Margin="0,0,0,6" />
                            <!-- Live preview: theme resources are set on PreviewHost only -->
                            <Border x:Name="PreviewHost" Padding="16" CornerRadius="8" Background="#22808080" HorizontalAlignment="Stretch">
                              <!-- Shrinks the preview when the window is narrow; never enlarges it -->
                              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <Grid x:Name="Preview" Width="360" Height="129" IsHitTestVisible="False"
                                      TextElement.Foreground="{DynamicResource ThemeForeground}"
                                      TextElement.FontFamily="{DynamicResource ThemeFont}">
                                    <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeBackground}"
                                            Effect="{DynamicResource ThemeShadow}" />
                                    <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Visibility="{DynamicResource ThemeCoverBackdropVisibility}"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverBackdrop}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeImageBrush}" />
                                    <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeOverlay}"
                                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="{DynamicResource ThemeBorderThickness}" />

                                    <Grid Margin="14,10,10,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="84" Height="84" Margin="0,0,12,0">
                                                <Border CornerRadius="{DynamicResource ThemeCoverRadius}" Background="{DynamicResource ThemeTrack}">
                                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="28" Opacity="0.5"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border CornerRadius="{DynamicResource ThemeCoverRadius}"
                                                        Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid>
                                                    <StackPanel Margin="0,0,70,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource ThemeSecondary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource PinButton}" FontSize="12" Width="22" Height="22" />
                                                        <Button Style="{StaticResource LyricsButton}" Content="&#xE720;" FontSize="12" Width="22" Height="22" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="22" Height="22" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="-6,6,0,0">
                                                    <Button Style="{StaticResource ShuffleButton}" Content="&#xE8B1;" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" />
                                                    <Button Style="{StaticResource IconButton}" Content="{Binding PlayGlyph}" FontSize="20" Width="44" Height="40" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" />
                                                    <Button Style="{StaticResource RepeatButton}" Content="{Binding RepeatGlyph}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,10,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="1:23" FontSize="11" Foreground="{DynamicResource ThemeSecondary}" MinWidth="34" />
                                            <ProgressBar Grid.Column="1" Style="{StaticResource ThinProgress}" Height="4" Value="0.4" Margin="6,0" />
                                            <TextBlock Grid.Column="2" Text="3:45" FontSize="11" Foreground="{DynamicResource ThemeSecondary}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                              </Viewbox>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="UseThemeButton" Content="{l:Tr theme_use}" Style="{DynamicResource AccentButtonStyle}"
                                        Padding="14,6" Click="OnUseTheme" />
                                <TextBlock x:Name="ThemeInUse" Text="{l:Tr theme_in_use}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{l:Tr themes_open_folder}" Padding="12,5" Click="OnOpenThemes" />
                                <Button Content="{l:Tr common_reload}" Padding="12,5" Margin="8,0,0,0" Click="OnReloadThemes" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="{l:Tr themes_hint}" />
                            <TextBlock x:Name="ThemeErrors" Style="{StaticResource Hint}" Foreground="#E0A030" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr viz_title}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="{l:Tr viz_show}" IsChecked="{Binding ShowVisualizer}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{l:Tr viz_position}" VerticalAlignment="Center" Width="130" />
                                <ComboBox x:Name="VisualizerPositionBox" MinWidth="240" SelectionChanged="OnVisualizerPositionChanged">
                                    <ComboBoxItem Tag="Controls" Content="{l:Tr viz_pos_controls}" />
                                    <ComboBoxItem Tag="Cover" Content="{l:Tr viz_pos_cover}" />
                                    <ComboBoxItem Tag="Bottom" Content="{l:Tr viz_pos_bottom}" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr viz_hint}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr size_title}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Text="Zoom" VerticalAlignment="Center" Width="60" />
                                <Slider x:Name="ZoomSlider" Minimum="70" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="OnZoomChanged" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr zoom_hint}" />
                            <Button Content="{l:Tr size_reset_default}" Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Click="OnResetSize" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== ATALHOS E CONTROLES ===================== -->
                <StackPanel x:Name="PageControls" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_controls}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr hotkeys_title}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="{l:Tr hotkeys_hint}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="HotkeyRows" />
                    </Border>
                    <Button Content="{l:Tr hotkeys_reset}" Padding="12,5" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Click="OnResetHotkeys" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Mouse" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:Tr wheel_player}" VerticalAlignment="Center" />
                            <ComboBox x:Name="WheelBox" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left"
                                      SelectionChanged="OnMouseOptionChanged">
                                <ComboBoxItem Tag="Volume" Content="{l:Tr wheel_volume}" />
                                <ComboBoxItem Tag="Track" Content="{l:Tr wheel_track}" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="{l:Tr wheel_taskbar}" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="TaskbarWheelBox" Grid.Row="1" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left"
                                      Margin="0,10,0,0" SelectionChanged="OnMouseOptionChanged">
                                <ComboBoxItem Tag="Volume" Content="{l:Tr wheel_volume}" />
                                <ComboBoxItem Tag="Track" Content="{l:Tr wheel_track}" />
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="{l:Tr middle_click}" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="MiddleClickBox" Grid.Row="2" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left"
                                      Margin="0,10,0,0" SelectionChanged="OnMouseOptionChanged">
                                <ComboBoxItem Tag="Mute" Content="{l:Tr action_mute}" />
                                <ComboBoxItem Tag="PlayPause" Content="{l:Tr action_playpause}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="{l:Tr wheel_hint}" />
                </StackPanel>

                <!-- ===================== AUTOMAÇÃO ===================== -->
                <StackPanel x:Name="PageAutomation" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_automation}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr calls_title}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="PauseOnCallBox" Content="{l:Tr calls_enable}" Click="OnAutomationClick" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr calls_hint}" />
                            <CheckBox x:Name="ResumeAfterCallBox" Content="{l:Tr calls_resume}" Margin="0,10,0,0"
                                      Click="OnAutomationClick" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr calls_apps}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr calls_apps_hint}" />
                            <StackPanel x:Name="MicAppsPanel" Margin="0,8,0,0" />
                            <Button Content="{l:Tr common_refresh_list}" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnRefreshMicApps" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr duck_title}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="DuckBox" Content="{l:Tr duck_enable}" Click="OnAutomationClick" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr duck_hint}" />
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock x:Name="DuckLevelText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr duck_level}" VerticalAlignment="Center" Width="100" />
                                <Slider x:Name="DuckLevelSlider" Minimum="0" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" ValueChanged="OnDuckLevelChanged" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== HISTÓRICO ===================== -->
                <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_history}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="RecordHistoryBox" Content="{l:Tr history_record}" Click="OnRecordHistoryClick" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr history_record_hint}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{l:Tr history_open}" Padding="14,6" Style="{DynamicResource AccentButtonStyle}" Click="OnOpenHistory" />
                        <Button Content="{l:Tr history_open_stats}" Padding="12,6" Margin="8,0,0,0" Click="OnOpenStatistics" />
                    </StackPanel>
                </StackPanel>

                <!-- ===================== TRANSMISSÃO (OBS) ===================== -->
                <StackPanel x:Name="PageStream" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_stream}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="NowPlayingBox" Content="{l:Tr np_enable}" Click="OnNowPlayingChanged" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr np_hint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr np_folder}" FontWeight="SemiBold" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="{l:Tr common_open}" Padding="12,4" Margin="6,0,0,0" Click="OnOpenNowPlayingFolder" />
                                <Button DockPanel.Dock="Right" Content="{l:Tr common_choose}" Padding="12,4" Margin="6,0,0,0" Click="OnChooseNowPlayingFolder" />
                                <TextBox x:Name="NowPlayingFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{l:Tr np_text}" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBox x:Name="TemplateBox" Margin="0,8,0,0" TextChanged="OnTemplateChanged" />
                            <TextBlock x:Name="TemplatePreview" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr np_placeholders}" />

                            <CheckBox x:Name="ClearWhenPausedBox" Content="{l:Tr np_clear_paused}" Margin="0,12,0,0"
                                      Click="OnNowPlayingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr np_howto}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{l:Tr np_howto_text}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== BARRA DE TAREFAS ===================== -->
                <StackPanel x:Name="PageTaskbar" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_taskbar}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr taskbar_screen}" FontWeight="SemiBold" />
                            <ComboBox x:Name="ScreenBox" Margin="0,8,0,0" MinWidth="240" HorizontalAlignment="Left"
                                      DisplayMemberPath="Label" SelectionChanged="OnScreenChanged" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr taskbar_screen_hint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="{l:Tr taskbar_autohide}" IsChecked="{Binding AutoHideWhenIdle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr taskbar_autohide_hint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr taskbar_position}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr taskbar_position_hint}" />
                            <Button Content="{l:Tr taskbar_reset_position}" Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Click="OnResetTaskbarPosition" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== ATUALIZAÇÕES ===================== -->
                <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_updates}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="CheckButton" Content="{l:Tr updates_check_now}" Padding="12,5" Click="OnCheckUpdates" />
                                <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="KeepUpdatedBox" Content="{l:Tr updates_keep}" Click="OnKeepUpdatedClick" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:Tr updates_keep_hint}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,12,0,0">
                        <Hyperlink Click="OnOpenReleases">Ver novidades de cada versão no GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="NotInstalledHint" Style="{StaticResource Hint}" Margin="0,12,0,0" Visibility="Collapsed"
                               Text="{l:Tr updates_not_installed}" />
                </StackPanel>

                <!-- ===================== SOBRE ===================== -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_about}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MiniPlayer" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutVersion" Opacity="0.7" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="{l:Tr about_desc}" />
                            <TextBlock Margin="0,10,0,0">
                                <Hyperlink Click="OnOpenRepo">github.com/williamanjo/MiniPlayer</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{l:Tr about_open_settings_folder}" Padding="12,5" Click="OnOpenSettingsFolder" />
                        <Button Content="{l:Tr themes_open_folder}" Padding="12,5" Margin="8,0,0,0" Click="OnOpenThemes" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
