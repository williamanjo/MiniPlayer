<Window x:Class="MiniPlayer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniPlayer.Localization"
        xmlns:s="clr-namespace:MiniPlayer.Services"
        xmlns:local="clr-namespace:MiniPlayer.Views"
        Title="{l:Tr settings_window_title}" Width="900" Height="640" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <!-- Settings "card": rows sit in cards with a small gap, like Windows 11 Settings -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#22808080" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Indented area for sub-options, shown only when the main option is on -->
        <Style x:Key="Details" TargetType="StackPanel">
            <Setter Property="Margin" Value="40,12,0,0" />
        </Style>
        <Style x:Key="DetailsSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#22808080" />
            <Setter Property="Margin" Value="-56,0,-16,12" />
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- On/off switch (CheckBox) -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="#99808080" Background="Transparent" />
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="#CC808080" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <ListBox x:Name="Nav" Margin="8,12,4,12" BorderThickness="0" Background="Transparent" SelectionChanged="OnNavChanged">
            <ListBoxItem Tag="General" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" /><TextBlock Text="{l:Tr nav_general}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Appearance" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE790;" /><TextBlock Text="{l:Tr nav_appearance}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Controls" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE765;" /><TextBlock Text="{l:Tr nav_controls}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Automation" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE945;" /><TextBlock Text="{l:Tr nav_automation}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="History" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;" /><TextBlock Text="{l:Tr nav_history}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Stream" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE93E;" /><TextBlock Text="{l:Tr nav_stream}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Taskbar" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE90E;" /><TextBlock Text="{l:Tr nav_taskbar}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Updates" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE895;" /><TextBlock Text="{l:Tr nav_updates}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="About" Padding="8,10">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE946;" /><TextBlock Text="{l:Tr nav_about}" /></StackPanel>
            </ListBoxItem>
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16,32,32" MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- ===================== GERAL ===================== -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_general}" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE774;" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{l:Tr language_title}" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="2" MinWidth="240" SelectionChanged="OnLanguageChanged">
                                <ComboBoxItem Tag="auto" Content="{l:Tr language_auto}" />
                                <ComboBoxItem Tag="en" Content="{l:Tr language_english}" />
                                <ComboBoxItem Tag="pt-BR" Content="{l:Tr language_portuguese}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr sec_player}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7F4;" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr general_mode_title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr general_mode_hint}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Style="{StaticResource Details}" Orientation="Horizontal">
                                <RadioButton x:Name="ModeFloating" Content="{l:Tr general_mode_floating}" Checked="OnModeChecked" Margin="0,0,24,0" />
                                <RadioButton x:Name="ModeTaskbar" Content="{l:Tr general_mode_taskbar}" Checked="OnModeChecked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE718;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr general_pin}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr general_pin_hint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding PinOnTop}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE720;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr general_lyrics}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr lyrics_hint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowLyrics}" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr sleep_title}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE708;" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock x:Name="SleepStatus" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr sleep_hint}" />
                                </StackPanel>
                                <Button x:Name="SleepCancel" Grid.Column="2" Content="{l:Tr common_cancel}" Padding="12,4" Click="OnSleepCancel" />
                            </Grid>
                            <StackPanel Style="{StaticResource Details}">
                                <WrapPanel x:Name="SleepButtons" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr sleep_fade}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="SleepFadeBox" Grid.Column="1" Style="{StaticResource Switch}" Click="OnSleepFadeClick" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr sec_startup}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7E8;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr general_autostart}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr autostart_hint}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartBox" Grid.Column="2" Style="{StaticResource Switch}" Click="OnAutoStartClick" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===================== APARÊNCIA ===================== -->
                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_appearance}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr theme}" Margin="2,8,0,8" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="ThemeList" Height="300" SelectionChanged="OnThemeSelected"
                                     MouseDoubleClick="OnThemeDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <!-- Swatch: theme background with accent dot -->
                                            <Grid Width="34" Height="34" Margin="0,0,10,0">
                                                <Border CornerRadius="6" Background="{Binding Background}" BorderBrush="#33808080" BorderThickness="1" />
                                                <Ellipse Width="12" Height="12" Fill="{Binding Accent}" />
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="{l:Tr theme_preview}" Opacity="0.7" Margin="0,0,0,6" />
                                <!-- Live preview: theme resources are set on PreviewHost only -->
                                <Border x:Name="PreviewHost" Padding="16" CornerRadius="8" Background="#22808080" HorizontalAlignment="Stretch">
                                  <!-- Shrinks the preview when the window is narrow; never enlarges it -->
                                  <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <local:ThemePreview x:Name="Preview" />
                                  </Viewbox>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="UseThemeButton" Content="{l:Tr theme_use}" Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,6" Click="OnUseTheme" />
                                    <TextBlock x:Name="ThemeInUse" Text="{l:Tr theme_in_use}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{l:Tr theme_customize}" Padding="12,5" Margin="0,0,8,8" Click="OnCustomizeTheme" />
                                    <Button Content="{l:Tr theme_import}" Padding="12,5" Margin="0,0,8,8" Click="OnImportTheme" />
                                    <Button Content="{l:Tr theme_export}" Padding="12,5" Margin="0,0,8,8" Click="OnExportTheme" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Content="{l:Tr themes_open_folder}" Padding="12,5" Click="OnOpenThemes" />
                                    <Button Content="{l:Tr common_reload}" Padding="12,5" Margin="8,0,0,0" Click="OnReloadThemes" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="{l:Tr themes_hint}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr theme_show_author}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ShowThemeAuthor}" />
                                </Grid>
                                <TextBlock x:Name="ThemeErrors" Style="{StaticResource Hint}" Foreground="#E0A030" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr sec_cover}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8B9;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr hdcover_title}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr hdcover_hint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding HdCovers}" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr viz_title}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE9D9;" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr viz_show}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr viz_hint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowVisualizer}" />
                            </Grid>
                            <StackPanel Style="{StaticResource Details}" Visibility="{Binding ShowVisualizer, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource DetailsSeparator}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr viz_position}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="VisualizerPositionBox" Grid.Column="1" MinWidth="240" SelectionChanged="OnVisualizerPositionChanged">
                                        <ComboBoxItem Tag="Controls" Content="{l:Tr viz_pos_controls}" />
                                        <ComboBoxItem Tag="Cover" Content="{l:Tr viz_pos_cover}" />
                                        <ComboBoxItem Tag="Bottom" Content="{l:Tr viz_pos_bottom}" />
                                        <ComboBoxItem Tag="AroundCover" Content="{l:Tr viz_pos_around}" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{l:Tr viz_bars}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr viz_bars_hint}" />
                                    </StackPanel>
                                    <Slider x:Name="VisualizerBarsSlider" Grid.Column="1" Width="200" Minimum="0" Maximum="160" TickFrequency="4"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding VisualizerBars}" ValueChanged="OnVisualizerBarsChanged" />
                                    <TextBlock x:Name="VisualizerBarsText" Grid.Column="2" MinWidth="80" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr size_title}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE71E;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr zoom_title}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr zoom_hint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="ZoomSlider" Width="180" Minimum="70" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="OnZoomChanged" VerticalAlignment="Center" />
                                <TextBlock x:Name="ZoomText" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1" Content="{l:Tr size_reset_default}" Padding="12,4" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Click="OnResetSize" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===================== ATALHOS E CONTROLES ===================== -->
                <StackPanel x:Name="PageControls" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_controls}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr hotkeys_title}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr hotkeys_hint}" Margin="0,0,0,8" />
                            <StackPanel x:Name="HotkeyRows" />
                            <Button Content="{l:Tr hotkeys_reset}" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnResetHotkeys" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr mouse_title}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE962;" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{l:Tr wheel_player}" VerticalAlignment="Center" />
                            <ComboBox x:Name="WheelBox" Grid.Column="2" MinWidth="200" SelectionChanged="OnMouseOptionChanged">
                                <ComboBoxItem Tag="Volume" Content="{l:Tr wheel_volume}" />
                                <ComboBoxItem Tag="Track" Content="{l:Tr wheel_track}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE90E;" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{l:Tr wheel_taskbar}" VerticalAlignment="Center" />
                            <ComboBox x:Name="TaskbarWheelBox" Grid.Column="2" MinWidth="200" SelectionChanged="OnMouseOptionChanged">
                                <ComboBoxItem Tag="Volume" Content="{l:Tr wheel_volume}" />
                                <ComboBoxItem Tag="Track" Content="{l:Tr wheel_track}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8B0;" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{l:Tr middle_click}" VerticalAlignment="Center" />
                            <ComboBox x:Name="MiddleClickBox" Grid.Column="2" MinWidth="200" SelectionChanged="OnMouseOptionChanged">
                                <ComboBoxItem Tag="Mute" Content="{l:Tr action_mute}" />
                                <ComboBoxItem Tag="PlayPause" Content="{l:Tr action_playpause}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr wheel_hint}" Margin="4,6,0,0" />
                </StackPanel>

                <!-- ===================== AUTOMAÇÃO ===================== -->
                <StackPanel x:Name="PageAutomation" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_automation}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr calls_title}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE717;" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr calls_enable}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr calls_hint}" />
                                </StackPanel>
                                <CheckBox x:Name="PauseOnCallBox" Grid.Column="2" Style="{StaticResource Switch}" Click="OnAutomationClick" />
                            </Grid>
                            <StackPanel Style="{StaticResource Details}" Visibility="{Binding IsChecked, ElementName=PauseOnCallBox, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource DetailsSeparator}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr calls_resume}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ResumeAfterCallBox" Grid.Column="1" Style="{StaticResource Switch}" Click="OnAutomationClick" />
                                </Grid>
                                <TextBlock Text="{l:Tr calls_apps}" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr calls_apps_hint}" />
                                <StackPanel x:Name="MicAppsPanel" Margin="0,8,0,0" />
                                <Button Content="{l:Tr common_refresh_list}" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnRefreshMicApps" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr duck_title}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE993;" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr duck_enable}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr duck_hint}" />
                                </StackPanel>
                                <CheckBox x:Name="DuckBox" Grid.Column="2" Style="{StaticResource Switch}" Click="OnAutomationClick" />
                            </Grid>
                            <StackPanel Style="{StaticResource Details}" Visibility="{Binding IsChecked, ElementName=DuckBox, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource DetailsSeparator}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr duck_level}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="DuckLevelSlider" Width="180" Minimum="0" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" ValueChanged="OnDuckLevelChanged" />
                                        <TextBlock x:Name="DuckLevelText" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== HISTÓRICO ===================== -->
                <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_history}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE81C;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr history_record}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr history_record_hint}" />
                            </StackPanel>
                            <CheckBox x:Name="RecordHistoryBox" Grid.Column="2" Style="{StaticResource Switch}" Click="OnRecordHistoryClick" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE9D2;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr history_view_title}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr history_view_hint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{l:Tr history_open}" Padding="12,4" Style="{DynamicResource AccentButtonStyle}" Click="OnOpenHistory" />
                                <Button Content="{l:Tr history_open_stats}" Padding="12,4" Margin="8,0,0,0" Click="OnOpenStatistics" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===================== TRANSMISSÃO (OBS) ===================== -->
                <StackPanel x:Name="PageStream" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_stream}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE93E;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr np_enable}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr np_hint}" />
                            </StackPanel>
                            <CheckBox x:Name="NowPlayingBox" Grid.Column="2" Style="{StaticResource Switch}" Click="OnNowPlayingChanged" />
                        </Grid>
                    </Border>

                    <!-- Everything below only matters while the files are being written -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NowPlayingBox, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr np_files_title}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr np_folder}" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="{l:Tr common_open}" Padding="12,4" Margin="6,0,0,0" Click="OnOpenNowPlayingFolder" />
                                    <Button DockPanel.Dock="Right" Content="{l:Tr common_choose}" Padding="12,4" Margin="6,0,0,0" Click="OnChooseNowPlayingFolder" />
                                    <TextBox x:Name="NowPlayingFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr np_text}" />
                                <TextBox x:Name="TemplateBox" Margin="0,8,0,0" TextChanged="OnTemplateChanged" />
                                <TextBlock x:Name="TemplatePreview" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr np_placeholders}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr np_clear_paused}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ClearWhenPausedBox" Grid.Column="1" Style="{StaticResource Switch}" Click="OnNowPlayingChanged" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr np_howto}" />
                        <Border Style="{StaticResource Card}">
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr np_howto_text}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ===================== BARRA DE TAREFAS ===================== -->
                <StackPanel x:Name="PageTaskbar" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_taskbar}" />
                    <TextBlock x:Name="TaskbarModeHint" Style="{StaticResource Hint}" Text="{l:Tr taskbar_only_hint}" Margin="2,0,0,12" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7F4;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr taskbar_screen}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr taskbar_screen_hint}" />
                            </StackPanel>
                            <ComboBox x:Name="ScreenBox" Grid.Column="2" MinWidth="200" DisplayMemberPath="Label" SelectionChanged="OnScreenChanged" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xED1A;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr taskbar_autohide}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr taskbar_autohide_hint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding AutoHideWhenIdle}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE759;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr taskbar_position}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr taskbar_position_hint}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="{l:Tr taskbar_reset_position}" Padding="12,4" Click="OnResetTaskbarPosition" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===================== ATUALIZAÇÕES ===================== -->
                <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_updates}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE895;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <Button x:Name="CheckButton" Grid.Column="2" Content="{l:Tr updates_check_now}" Padding="12,4" Click="OnCheckUpdates" />
                        </Grid>
                    </Border>
                    <Border x:Name="KeepUpdatedCard" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE896;" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Tr updates_keep}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr updates_keep_hint}" />
                            </StackPanel>
                            <CheckBox x:Name="KeepUpdatedBox" Grid.Column="2" Style="{StaticResource Switch}" Click="OnKeepUpdatedClick" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="4,12,0,0">
                        <Hyperlink Click="OnOpenReleases"><Run Text="{l:Tr releases_link}" /></Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="NotInstalledHint" Style="{StaticResource Hint}" Margin="4,12,0,0" Visibility="Collapsed"
                               Text="{l:Tr updates_not_installed}" />
                </StackPanel>

                <!-- ===================== SOBRE ===================== -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr nav_about}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Source="/Assets/app.ico" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static s:AppInfo.Name}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource Hint}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{l:Tr about_desc}" />
                                <TextBlock Margin="0,10,0,0">
                                    <Hyperlink Click="OnOpenRepo">github.com/williamanjo/MiniPlayer</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l:Tr about_open_settings_folder}" Padding="12,5" Click="OnOpenSettingsFolder" />
                        <Button Content="{l:Tr themes_open_folder}" Padding="12,5" Margin="8,0,0,0" Click="OnOpenThemes" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
