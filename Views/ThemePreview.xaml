<!-- Static sample of the floating player in whatever theme resources are set on this control
     (Settings → Appearance and the theme editor set ThemeService.BuildResources(theme) on it). -->
<UserControl x:Class="MiniPlayer.Views.ThemePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" Height="160" IsHitTestVisible="False"
             TextElement.Foreground="{DynamicResource ThemeForeground}"
             TextElement.FontFamily="{DynamicResource ThemeFont}">
    <Grid>
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeBackground}"
                Effect="{DynamicResource ThemeShadow}" />
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Visibility="{DynamicResource ThemeCoverBackdropVisibility}"
                RenderOptions.BitmapScalingMode="HighQuality" Effect="{DynamicResource ThemeBackdropEffect}" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="{Binding CoverBackdrop}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeImageBrush}"
                Opacity="{DynamicResource ThemeImageOpacity}" />
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeOverlay}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="{DynamicResource ThemeBorderThickness}" />

        <Grid Margin="14,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="84" Height="84" Margin="0,0,12,0">
                    <Border CornerRadius="{DynamicResource ThemeCoverRadius}" Background="{DynamicResource ThemeTrack}"
                            Effect="{DynamicResource ThemeCoverShadow}">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="28" Opacity="0.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="{DynamicResource ThemeCoverRadius}" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="{DynamicResource ThemeCoverRadius}" BorderBrush="{DynamicResource ThemeCoverBorder}"
                            BorderThickness="{DynamicResource ThemeCoverBorderThickness}" />
                    <Border Visibility="{DynamicResource ThemeCreditCoverVisibility}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Border x:Name="CoverCreditBadge" CornerRadius="4" Background="#99000000" Padding="5,1">
                            <TextBlock x:Name="CoverCredit" FontSize="8" Foreground="White" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource ThemeTitleSize}" FontWeight="{DynamicResource ThemeTitleWeight}"
                                       FontFamily="{DynamicResource ThemeTitleFont}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource ThemeSubtitleSize}" Foreground="{DynamicResource ThemeSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource PinButton}" FontSize="12" Width="22" Height="22" />
                            <Button Style="{StaticResource LyricsButton}" Content="&#xE720;" FontSize="12" Width="22" Height="22" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="22" Height="22"
                                    Foreground="{DynamicResource ThemeIcon}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="-6,6,0,0">
                        <Button Style="{StaticResource ShuffleButton}" Content="&#xE8B1;" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Foreground="{DynamicResource ThemeIcon}" />
                        <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Margin="2,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Foreground="{DynamicResource ThemeIcon}" />
                        <Button Style="{StaticResource RepeatButton}" Content="{Binding RepeatGlyph}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,10,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="1:23" FontSize="11" Foreground="{DynamicResource ThemeSecondary}" MinWidth="34" />
                <ProgressBar Grid.Column="1" Style="{StaticResource ThinProgress}" Height="{DynamicResource ThemeProgressHeight}" Value="0.4" Margin="6,0" />
                <TextBlock Grid.Column="2" Text="3:45" FontSize="11" Foreground="{DynamicResource ThemeSecondary}" />
            </Grid>
            <!-- Lyric line (shows the lyrics colors) -->
            <TextBlock Grid.Row="2" Text="♪ la la la" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource ThemeLyrics}" />
        </Grid>
        <!-- "theme by …" credit, placed like in the player -->
        <Border HorizontalAlignment="{DynamicResource ThemeCreditHorizontal}" VerticalAlignment="{DynamicResource ThemeCreditVertical}"
                Margin="{DynamicResource ThemeCreditMargin}" Visibility="{DynamicResource ThemeCreditVisibility}">
            <TextBlock x:Name="Credit" FontSize="9" Opacity="0.55" Foreground="{DynamicResource ThemeSecondary}" />
        </Border>
    </Grid>
</UserControl>
