<Window x:Class="MiniPlayer.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniPlayer.Localization"
        xmlns:local="clr-namespace:MiniPlayer.Views"
        xmlns:s="clr-namespace:MiniPlayer.Services"
        Title="{x:Static s:AppInfo.Name}" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="{Binding PinOnTop}"
        Foreground="{DynamicResource ThemeForeground}" FontFamily="{DynamicResource ThemeFont}"
        MouseWheel="OnWheel" MouseDown="OnMouseDown">
    <Window.Resources>
        <!-- Parts shared by the three layouts. "Tag" carries a Visibility for optional bits,
             set from code-behind depending on the available space. -->

        <!-- Album art (YouTube thumbnails are 16:9, so crop to square) -->
        <ControlTemplate x:Key="CoverTemplate" TargetType="ContentControl">
            <Grid ToolTip="{Binding FullText}">
                <!-- Visualizer "em volta da capa": ring of bars; the cover shrinks to fit inside -->
                <local:VisualizerControl StyleKind="Ring" BarCount="{Binding VisualizerBars}" ShapeRadius="{DynamicResource ThemeCoverRadius}" Fill="{DynamicResource ThemeVisualizer}" Opacity="{DynamicResource ThemeVisualizerOpacity}"
                                         Visibility="{Binding VisualizerAroundCover, Converter={StaticResource BoolToVis}}" />
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding CoverScale}" ScaleY="{Binding CoverScale}" />
                        <RotateTransform x:Name="Spin" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Border CornerRadius="{DynamicResource ThemeCoverRadius}" Background="{DynamicResource ThemeTrack}"
                        Effect="{DynamicResource ThemeCoverShadow}">
                    <Viewbox Margin="22" MaxWidth="48">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Opacity="0.5" />
                    </Viewbox>
                </Border>
                <Border CornerRadius="{DynamicResource ThemeCoverRadius}" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="{DynamicResource ThemeCoverRadius}" BorderBrush="{DynamicResource ThemeCoverBorder}"
                        BorderThickness="{DynamicResource ThemeCoverBorderThickness}" />
                <local:VisualizerControl VerticalAlignment="Bottom" Margin="6,0,6,5" BarCount="{Binding VisualizerBars}" Opacity="0.9"
                                         Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource FractionConverter}, ConverterParameter=0.32}"
                                         Fill="{DynamicResource ThemeVisualizer}"
                                         Visibility="{Binding VisualizerOnCover, Converter={StaticResource BoolToVis}}" />
            </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <!-- Vinyl: spins while playing, stops where it is when paused -->
                <DataTrigger Binding="{Binding CoverSpinning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinStory" HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" By="360"
                                                 Duration="0:0:12" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <PauseStoryboard BeginStoryboardName="SpinStory" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Shuffle / prev / play / next / repeat. Tag = visibility of shuffle + repeat. -->
        <ControlTemplate x:Key="TransportTemplate" TargetType="ContentControl">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ShuffleButton}" Content="&#xE8B1;" Command="{Binding ShuffleCommand}"
                        Margin="0,0,2,0" Visibility="{TemplateBinding Tag}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="{l:Tr tip_previous}"
                        Foreground="{DynamicResource ThemeIcon}" />
                <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}"
                        Margin="2,0" ToolTip="{l:Tr action_playpause}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="{l:Tr tip_next}"
                        Foreground="{DynamicResource ThemeIcon}" />
                <Button Style="{StaticResource RepeatButton}" Content="{Binding RepeatGlyph}" Command="{Binding RepeatCommand}"
                        Margin="2,0,0,0" Visibility="{TemplateBinding Tag}" />
            </StackPanel>
        </ControlTemplate>

        <!-- Pin / lyrics / taskbar / close. Tag = visibility of everything but close. -->
        <ControlTemplate x:Key="WindowButtonsTemplate" TargetType="ContentControl">
            <StackPanel Orientation="Horizontal">
                <!-- Sleep timer badge -->
                <TextBlock Text="{Binding SleepText, StringFormat='🌙 {0}'}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource ThemeSecondary}" ToolTip="{l:Tr tip_sleep}"
                           Visibility="{Binding HasSleepTimer, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" Visibility="{TemplateBinding Tag}">
                    <Button Style="{StaticResource PinButton}" FontSize="12" Width="26" Height="26" Click="OnTogglePin" />
                    <Button Style="{StaticResource LyricsButton}" Content="&#xE720;" FontSize="12" Width="26" Height="26"
                            Click="OnToggleLyrics" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE90E;" FontSize="12" Width="26" Height="26"
                            ToolTip="{l:Tr menu_to_taskbar}" Click="OnToTaskbar" Foreground="{DynamicResource ThemeIcon}" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="12" Width="26" Height="26"
                        ToolTip="{l:Tr tip_settings}" Click="OnOpenSettings" Foreground="{DynamicResource ThemeIcon}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="26" Height="26"
                        ToolTip="{l:Tr tip_hide}" Click="OnClose" Foreground="{DynamicResource ThemeIcon}" />
            </StackPanel>
        </ControlTemplate>

        <!-- Time + seekable bar + duration -->
        <ControlTemplate x:Key="ProgressTemplate" TargetType="ContentControl">
            <Grid Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource ThemeSecondary}"
                           MinWidth="34" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand" Margin="6,0"
                      MouseLeftButtonDown="OnSeek" ToolTip="{l:Tr tip_seek}">
                    <ProgressBar Style="{StaticResource ThinProgress}" Height="{DynamicResource ThemeProgressHeight}" Value="{Binding Progress, Mode=OneWay}" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource ThemeSecondary}"
                           MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </ControlTemplate>

        <!-- Synced lyrics. Tag = visibility of the previous/next lines (hidden when space is short). -->
        <ControlTemplate x:Key="LyricsTemplate" TargetType="ContentControl">
            <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowLyrics, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LyricPrevious}" FontSize="12" Foreground="{DynamicResource ThemeLyricsDim}" Opacity="0.75"
                           TextAlignment="Center" TextWrapping="Wrap" Visibility="{TemplateBinding Tag}" />
                <TextBlock Text="{Binding LyricCurrent}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{DynamicResource ThemeLyrics}"
                           TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Text="{Binding LyricNext}" FontSize="12" Foreground="{DynamicResource ThemeLyricsDim}" Opacity="0.75"
                           TextAlignment="Center" TextWrapping="Wrap" Visibility="{TemplateBinding Tag}" />
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>

    <!-- Root has an explicit content size (user-resizable); zoom is a LayoutTransform on top of it. -->
    <Grid x:Name="Root" Margin="8" Width="384" Height="129">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- Theme layers. Shadow on its own layer so the text stays crisp. -->
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeBackground}"
                Effect="{DynamicResource ThemeShadow}" />
        <!-- Backdrop "cover": tiny album art upscaled = cheap blur -->
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Visibility="{DynamicResource ThemeCoverBackdropVisibility}"
                RenderOptions.BitmapScalingMode="HighQuality" Effect="{DynamicResource ThemeBackdropEffect}" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="{Binding CoverBackdrop}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeImageBrush}"
                Opacity="{DynamicResource ThemeImageOpacity}" />
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeOverlay}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="{DynamicResource ThemeBorderThickness}" />

        <!-- Visualizer option "rodapé": soft wave along the bottom, behind the content -->
        <local:VisualizerControl VerticalAlignment="Bottom" Height="26" Margin="12,0,12,4" BarCount="{Binding VisualizerBars}" Opacity="0.35"
                                 Fill="{DynamicResource ThemeVisualizer}"
                                 Visibility="{Binding VisualizerAtBottom, Converter={StaticResource BoolToVis}}" />

        <Grid x:Name="Body" Margin="14,10,10,10" Background="Transparent" MouseLeftButtonDown="OnDragArea">
            <Grid.ContextMenu>
                <ContextMenu Opened="OnMenuOpened">
                    <MenuItem Header="{l:Tr menu_pin}" IsCheckable="True" IsChecked="{Binding PinOnTop}" />
                    <MenuItem Header="{l:Tr menu_lyrics}" IsCheckable="True" IsChecked="{Binding ShowLyrics}" />
                    <MenuItem Header="{l:Tr menu_to_taskbar}" Click="OnToTaskbar" />
                    <Separator />
                    <MenuItem x:Name="ThemesMenu" Header="{l:Tr theme}" />
                    <MenuItem x:Name="SleepTimerMenu" Header="{l:Tr sleep_title}" />
                    <MenuItem Header="{l:Tr menu_reset_size}" Click="OnResetSize" />
                    <Separator />
                    <MenuItem Header="{l:Tr menu_history}" Click="OnOpenHistory" />
                    <MenuItem Header="{l:Tr menu_settings}" Click="OnOpenSettings" />
                    <MenuItem Header="{l:Tr menu_hide}" Click="OnClose" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- ========== MINI: squashed, everything on one row ========== -->
            <Grid x:Name="MiniLayout" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="MiniCover" Template="{StaticResource CoverTemplate}" Margin="0,0,10,0" />
                <DockPanel x:Name="MiniText" Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding FullText}">
                    <local:VisualizerControl DockPanel.Dock="Left" Width="14" Height="16" Margin="0,0,8,0" BarCount="4"
                                             StyleKind="Equalizer" Fill="{DynamicResource ThemeVisualizer}"
                                             Visibility="{Binding VisualizerAtControls, Converter={StaticResource BoolToVis}}" />
                    <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource ThemeTitleSizeSmall}" FontWeight="{DynamicResource ThemeTitleWeight}" FontFamily="{DynamicResource ThemeTitleFont}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TaskbarSubtitle}" FontSize="11" Foreground="{DynamicResource ThemeSecondary}"
                               TextTrimming="CharacterEllipsis" Background="Transparent" Cursor="Hand"
                               MouseLeftButtonDown="OnPickSource" />
                    </StackPanel>
                </DockPanel>
                <ContentControl x:Name="MiniTransport" Grid.Column="2" Template="{StaticResource TransportTemplate}"
                                VerticalAlignment="Center" Margin="6,0,0,0" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="24" Height="24"
                        VerticalAlignment="Center" ToolTip="{l:Tr tip_hide}" Click="OnClose" Foreground="{DynamicResource ThemeIcon}" />
                <Grid Grid.ColumnSpan="4" Height="8" Margin="0,0,0,-9" VerticalAlignment="Bottom" Background="Transparent"
                      Cursor="Hand" MouseLeftButtonDown="OnSeek"
                      Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource ThinProgress}" Height="2" VerticalAlignment="Center"
                                 Value="{Binding Progress, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- ========== STANDARD: cover left, info + controls right ========== -->
            <Grid x:Name="StandardLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="StdCover" Template="{StaticResource CoverTemplate}" Width="84" Height="84"
                                    Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullText}">
                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource ThemeTitleSize}" FontWeight="{DynamicResource ThemeTitleWeight}" FontFamily="{DynamicResource ThemeTitleFont}" TextTrimming="CharacterEllipsis" />
                                <!-- Click: choose which tab/app to control -->
                                <DockPanel Margin="0,1,0,0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left"
                                           MouseLeftButtonDown="OnPickSource" ToolTip="{l:Tr tip_pick_source}">
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                               FontSize="9" Foreground="{DynamicResource ThemeSecondary}" VerticalAlignment="Center" Margin="4,1,0,0" />
                                    <TextBlock Text="{Binding SubtitleDisplay}" FontSize="{DynamicResource ThemeSubtitleSize}" Foreground="{DynamicResource ThemeSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                            <ContentControl x:Name="StdWindowButtons" Grid.Column="1" Template="{StaticResource WindowButtonsTemplate}"
                                            VerticalAlignment="Top" Margin="4,0,0,0" />
                        </Grid>
                        <DockPanel Grid.Row="1" Margin="-6,6,0,0">
                            <ContentControl x:Name="StdTransport" DockPanel.Dock="Left" Template="{StaticResource TransportTemplate}" />
                            <!-- Audio bars fill the space right of the buttons -->
                            <local:VisualizerControl Height="22" Margin="10,0,4,0" VerticalAlignment="Center" BarCount="{Binding VisualizerBars}"
                                                     Opacity="{DynamicResource ThemeVisualizerOpacity}" Fill="{DynamicResource ThemeVisualizer}"
                                                     Visibility="{Binding VisualizerAtControls, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </Grid>
                </Grid>
                <ContentControl Grid.Row="1" Template="{StaticResource ProgressTemplate}" Margin="0,10,4,0" />
                <ContentControl x:Name="StdLyrics" Grid.Row="2" Template="{StaticResource LyricsTemplate}" Margin="4,6,4,0"
                                ClipToBounds="True" SizeChanged="OnLyricsSizeChanged" />
            </Grid>

            <!-- ========== TALL: portrait card, big cover on top ========== -->
            <Grid x:Name="TallLayout" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ContentControl x:Name="TallWindowButtons" Template="{StaticResource WindowButtonsTemplate}"
                                HorizontalAlignment="Right" Margin="0,0,0,4" />
                <ContentControl x:Name="TallCover" Grid.Row="1" Template="{StaticResource CoverTemplate}" HorizontalAlignment="Center" />
                <StackPanel Grid.Row="2" Margin="0,10,4,0" ToolTip="{Binding FullText}">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource ThemeTitleSizeLarge}" FontWeight="{DynamicResource ThemeTitleWeight}" FontFamily="{DynamicResource ThemeTitleFont}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SubtitleDisplay}" FontSize="{DynamicResource ThemeSubtitleSize}" Foreground="{DynamicResource ThemeSecondary}"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Background="Transparent" Cursor="Hand"
                               MouseLeftButtonDown="OnPickSource" Margin="0,2,0,0" />
                </StackPanel>
                <ContentControl Grid.Row="3" Template="{StaticResource ProgressTemplate}" Margin="0,8,4,0" />
                <ContentControl x:Name="TallTransport" Grid.Row="4" Template="{StaticResource TransportTemplate}"
                                HorizontalAlignment="Center" Margin="0,2,0,0" />
                <local:VisualizerControl Grid.Row="5" Height="18" Width="160" Margin="0,6,0,0" BarCount="{Binding VisualizerBars}"
                                         HorizontalAlignment="Center" Opacity="{DynamicResource ThemeVisualizerOpacity}" Fill="{DynamicResource ThemeVisualizer}"
                                         Visibility="{Binding VisualizerAtControls, Converter={StaticResource BoolToVis}}" />
                <ContentControl x:Name="TallLyrics" Grid.Row="6" Template="{StaticResource LyricsTemplate}" Margin="4,6,4,0"
                                ClipToBounds="True" SizeChanged="OnLyricsSizeChanged" />
            </Grid>
        </Grid>

        <!-- "Tema por …" credit, in the bottom padding (hidden in the mini layout) -->
        <Border x:Name="ThemeCreditHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" IsHitTestVisible="False">
            <TextBlock Text="{Binding ThemeCredit}" FontSize="9" Opacity="0.55" Foreground="{DynamicResource ThemeSecondary}"
                       TextTrimming="CharacterEllipsis" Visibility="{Binding HasThemeCredit, Converter={StaticResource BoolToVis}}" />
        </Border>

        <!-- Resize grips: edges + corners -->
        <Border Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" Tag="L"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Tag="R"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Height="5" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNS" Tag="T"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNS" Tag="B"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                Cursor="SizeNWSE" Tag="TL" MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
                Cursor="SizeNESW" Tag="TR" MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"
                Cursor="SizeNESW" Tag="BL" MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                Cursor="SizeNWSE" Tag="BR" MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
    </Grid>
</Window>
