<Window x:Class="MiniPlayer.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniPlayer" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="{Binding PinOnTop}"
        Foreground="{DynamicResource ThemeForeground}" FontFamily="{DynamicResource ThemeFont}"
        MouseWheel="OnWheel" MouseDown="OnMouseDown">
    <!-- Fixed design width; the whole player is scaled (crisp vector) instead of re-laid out -->
    <Grid x:Name="Root" Margin="8" Width="384">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <!-- Theme layers. Shadow on its own layer so the text stays crisp. -->
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeBackground}"
                Effect="{DynamicResource ThemeShadow}" />
        <!-- Backdrop "cover": tiny album art upscaled = cheap blur -->
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Visibility="{DynamicResource ThemeCoverBackdropVisibility}"
                RenderOptions.BitmapScalingMode="HighQuality">
            <Border.Background>
                <ImageBrush ImageSource="{Binding CoverBackdrop}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeImageBrush}" />
        <Border CornerRadius="{DynamicResource ThemeCornerRadius}" Background="{DynamicResource ThemeOverlay}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="{DynamicResource ThemeBorderThickness}" />

        <Grid Margin="14,10,10,10" Background="Transparent" MouseLeftButtonDown="OnDragArea">
            <Grid.ContextMenu>
                <ContextMenu x:Name="PlayerMenu" Opened="OnMenuOpened">
                    <MenuItem x:Name="ThemesMenu" Header="Tema" />
                    <MenuItem x:Name="SizeMenu" Header="Tamanho" />
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cover + track info + controls -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Album art (YouTube thumbnails are 16:9, so crop to square) -->
                <Grid Width="84" Height="84" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="{Binding FullText}">
                    <Border CornerRadius="{DynamicResource ThemeCoverRadius}" Background="{DynamicResource ThemeTrack}">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="28" Opacity="0.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="{DynamicResource ThemeCoverRadius}" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Track info + window buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullText}">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <!-- Click: choose which tab/app to control -->
                            <DockPanel x:Name="SourcePicker" Margin="0,1,0,0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left"
                                       MouseLeftButtonDown="OnPickSource" ToolTip="Escolher aba / app">
                                <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                           FontSize="9" Foreground="{DynamicResource ThemeSecondary}" VerticalAlignment="Center" Margin="4,1,0,0" />
                                <TextBlock Text="{Binding SubtitleDisplay}" FontSize="12" Foreground="{DynamicResource ThemeSecondary}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                            <Button Style="{StaticResource PinButton}" FontSize="12" Width="26" Height="26"
                                    Click="OnTogglePin" />
                            <Button Style="{StaticResource LyricsButton}" Content="&#xE720;" FontSize="12" Width="26" Height="26"
                                    Click="OnToggleLyrics" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE90E;" FontSize="12" Width="26" Height="26"
                                    ToolTip="Mover para a barra de tarefas" Click="OnToTaskbar" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="26" Height="26"
                                    ToolTip="Ocultar (continua na bandeja)" Click="OnClose" />
                        </StackPanel>
                    </Grid>

                    <!-- Transport controls -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="-6,6,0,0">
                        <Button Style="{StaticResource ShuffleButton}" Content="&#xE8B1;" Command="{Binding ShuffleCommand}" Margin="0,0,2,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="Anterior" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}"
                                FontSize="20" Width="44" Height="40" Margin="2,0" ToolTip="Play / Pause" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Próxima" />
                        <Button Style="{StaticResource RepeatButton}" Content="{Binding RepeatGlyph}" Command="{Binding RepeatCommand}" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Progress -->
            <Grid Grid.Row="1" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}" Margin="0,10,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource ThemeSecondary}" MinWidth="34" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand" Margin="6,0"
                      MouseLeftButtonDown="OnSeek" ToolTip="Clique para avançar/voltar">
                    <ProgressBar Style="{StaticResource ThinProgress}" Height="4" Value="{Binding Progress, Mode=OneWay}" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource ThemeSecondary}" MinWidth="34"
                           TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Synced lyrics -->
            <StackPanel Grid.Row="2" Margin="4,10,4,0" Visibility="{Binding ShowLyrics, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LyricPrevious}" FontSize="12" Foreground="{DynamicResource ThemeSecondary}" Opacity="0.75" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LyricCurrent}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Text="{Binding LyricNext}" FontSize="12" Foreground="{DynamicResource ThemeSecondary}" Opacity="0.75" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <!-- Resize grips (sides + corners); drag scales the player -->
        <Border Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" Tag="L"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Tag="R"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                Cursor="SizeNWSE" Tag="L" MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
                Cursor="SizeNESW" Tag="R" MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"
                Cursor="SizeNESW" Tag="L" MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                Cursor="SizeNWSE" Tag="R" MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" />
    </Grid>
</Window>
