<!-- Look shared by the installer (Installer/, linked) and the app's first-run welcome window. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:MiniPlayer.Views">
    <LinearGradientBrush x:Key="Grad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F472B6" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="0.5" />
        <GradientStop Color="#38BDF8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Line" Color="#E6DCF7" />
    <SolidColorBrush x:Key="Muted" Color="#5B6070" />

    <Style x:Key="Lead" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,16" />
    </Style>

    <!-- white rounded box used by toggles, options and tiles -->
    <Style x:Key="Box" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,11" />
    </Style>

    <!-- switch: a CheckBox drawn as a pill -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Style="{StaticResource Box}" Background="White">
                        <DockPanel>
                            <Grid Width="40" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="11" Background="#D9D2E9" />
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Grad}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- keep / start fresh: a RadioButton drawn as a card -->
    <Style x:Key="Choice" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" Style="{StaticResource Box}" BorderThickness="1.5" Padding="12">
                        <DockPanel>
                            <Grid Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                                <Ellipse Stroke="#9C8FC0" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#7C3AED" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#16141E" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="10" Padding="20,10" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#7C3AED" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Button}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource Grad}" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#EDE4FE" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- installing: the bar slides (Velopack's silent setup reports no percentage) -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid v:RoundedClip.CornerRadius="4">
                        <Border x:Name="PART_Track" Background="#247C3AED" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Grad}" />
                        <Border x:Name="Slider" Width="190" HorizontalAlignment="Left" Visibility="Collapsed" Background="{StaticResource Grad}" CornerRadius="4">
                            <Border.RenderTransform><TranslateTransform x:Name="SliderX" X="-190" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Slider" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Slide">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SliderX" Storyboard.TargetProperty="X" From="-190" To="760" Duration="0:0:1.4">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Slide" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- theme tiles -->
    <Style x:Key="Themes" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <StackPanel Width="150" Margin="0,2,10,8">
                                    <Border x:Name="Pic" Height="74" CornerRadius="10" Background="#EFE9FB" BorderThickness="2" BorderBrush="Transparent">
                                        <Image Source="{Binding Image}" MaxWidth="136" MaxHeight="60" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Pic" Property="BorderBrush" Value="#7C3AED" />
                                        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Name" Property="Foreground" Value="#4C1D95" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
