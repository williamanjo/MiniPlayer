<Window x:Class="MiniPlayer.Views.OverlayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniPlayer.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{l:Tr ov_window_title}" Width="1180" Height="760" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#22808080" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="560" />
        </Grid.ColumnDefinitions>

        <!-- Form (rows are generated in code) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Form" Margin="24,8,16,24" />
        </ScrollViewer>

        <!-- Live preview (the real overlay.html in a browser) + actions -->
        <Border Grid.Column="1" Background="#0F808080" BorderBrush="#22808080" BorderThickness="1,0,0,0">
            <DockPanel Margin="24">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="{l:Tr ov_save}" Style="{DynamicResource AccentButtonStyle}" Padding="16,7"
                            HorizontalAlignment="Stretch" Click="OnSave" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="{l:Tr ov_reset}" Padding="12,6" HorizontalAlignment="Stretch" Click="OnReset" />
                        <Button Grid.Column="2" Content="{l:Tr common_cancel}" Padding="12,6" HorizontalAlignment="Stretch" Click="OnCancel" />
                    </Grid>
                </StackPanel>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr theme_preview}" Opacity="0.7" VerticalAlignment="Center" />
                        <ComboBox x:Name="PreviewBackground" Grid.Column="1" MinWidth="170" SelectionChanged="OnPreviewBackgroundChanged">
                            <ComboBoxItem Tag="checker" Content="{l:Tr ov_bg_checker}" IsSelected="True" />
                            <ComboBoxItem Tag="#18181b" Content="{l:Tr ov_bg_dark}" />
                            <ComboBoxItem Tag="#f4f4f5" Content="{l:Tr ov_bg_light}" />
                            <ComboBoxItem Tag="#00b140" Content="{l:Tr ov_bg_green}" />
                        </ComboBox>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{l:Tr ov_preview_hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,10" />
                    <Border CornerRadius="8" ClipToBounds="True" BorderBrush="#22808080" BorderThickness="1">
                        <Grid>
                            <wv2:WebView2 x:Name="Browser" />
                            <TextBlock x:Name="BrowserError" Visibility="Collapsed" TextWrapping="Wrap" Margin="16"
                                       VerticalAlignment="Center" TextAlignment="Center" Opacity="0.7" />
                        </Grid>
                    </Border>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
