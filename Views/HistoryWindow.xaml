<Window x:Class="MiniPlayer.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniPlayer.Localization"
        Title="{l:Tr history_window_title}" Width="760" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#22808080" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- One ranking row: name, count/time, proportional bar -->
        <DataTemplate x:Key="RankRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="12,0,0,0" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="12">
        <!-- ===================== HISTÓRICO ===================== -->
        <TabItem Header="{l:Tr nav_history}">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Tr history_clear}" Padding="12,5" Margin="8,0,0,0" Click="OnClear" />
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="SearchHint" Text="{l:Tr history_search}" IsHitTestVisible="False" Opacity="0.5"
                           Margin="12,0,0,0" VerticalAlignment="Center" />

                <ListBox x:Name="HistoryList" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0" Background="Transparent"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.IsVirtualizing="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnItemDoubleClick">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="4,14,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="4" Background="#22808080" Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="18" Opacity="0.5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Tr history_copy}" Click="OnCopy" />
                            <Separator />
                            <MenuItem Header="{l:Tr search_youtube}" Tag="youtube" Click="OnSearchWeb" />
                            <MenuItem Header="{l:Tr search_ytmusic}" Tag="ytmusic" Click="OnSearchWeb" />
                            <MenuItem Header="{l:Tr search_spotify}" Tag="spotify" Click="OnSearchWeb" />
                            <MenuItem Header="{l:Tr search_deezer}" Tag="deezer" Click="OnSearchWeb" />
                            <MenuItem Header="{l:Tr search_google}" Tag="google" Click="OnSearchWeb" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Visibility="Collapsed"
                           Text="{l:Tr history_empty}" />
                <TextBlock x:Name="CountText" Grid.Row="2" Style="{StaticResource Hint}" Margin="4,8,0,0"
                           Text="" />
            </Grid>
        </TabItem>

        <!-- ===================== ESTATÍSTICAS ===================== -->
        <TabItem Header="{l:Tr history_tab_stats}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,0,12">
                    <ComboBox x:Name="PeriodBox" HorizontalAlignment="Left" MinWidth="200" SelectionChanged="OnPeriodChanged">
                        <ComboBoxItem Tag="1" Content="{l:Tr period_today}" />
                        <ComboBoxItem Tag="7" Content="{l:Tr period_7}" IsSelected="True" />
                        <ComboBoxItem Tag="30" Content="{l:Tr period_30}" />
                        <ComboBoxItem Tag="0" Content="{l:Tr period_all}" />
                    </ComboBox>

                    <UniformGrid Columns="3" Margin="0,14,0,6">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr stats_time}" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="TotalTime" Style="{StaticResource BigNumber}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr stats_plays}" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="TotalPlays" Style="{StaticResource BigNumber}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr stats_artists}" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="TotalArtists" Style="{StaticResource BigNumber}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{l:Tr stats_top_artists}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl x:Name="TopArtists" ItemTemplate="{StaticResource RankRow}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{l:Tr stats_top_tracks}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl x:Name="TopTracks" ItemTemplate="{StaticResource RankRow}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr stats_sources}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl x:Name="TopSources" ItemTemplate="{StaticResource RankRow}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
