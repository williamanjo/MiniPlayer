<Window x:Class="MiniPlayer.Views.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniPlayer.Localization"
        xmlns:local="clr-namespace:MiniPlayer.Views"
        Title="{l:Tr editor_window_title}" Width="1040" Height="720" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#22808080" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Form (rows are generated in code) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Form" Margin="24,8,16,24" />
        </ScrollViewer>

        <!-- Live preview + actions -->
        <Border Grid.Column="1" Background="#0F808080" BorderBrush="#22808080" BorderThickness="1,0,0,0">
            <DockPanel Margin="24">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="SaveButton" Content="{l:Tr editor_save}" Style="{DynamicResource AccentButtonStyle}"
                            Padding="16,7" HorizontalAlignment="Stretch" Click="OnSave" />
                    <Button x:Name="SaveAsNewButton" Content="{l:Tr editor_save_new}" Padding="16,6" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" Click="OnSaveAsNew" />
                    <Button Content="{l:Tr common_cancel}" Padding="16,6" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnCancel" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:Tr theme_preview}" Opacity="0.7" Margin="0,0,0,8" />
                    <Border Padding="16" CornerRadius="8" Background="#22808080">
                        <Viewbox StretchDirection="DownOnly">
                            <local:ThemePreview x:Name="Preview" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{l:Tr editor_preview_hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
