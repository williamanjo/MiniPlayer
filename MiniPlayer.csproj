<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>MiniPlayer for Browser Music</AssemblyTitle>
    <Product>MiniPlayer for Browser Music</Product>
    <Version>1.7.0</Version>
    <!-- Custom Main: Velopack must run before WPF starts -->
    <StartupObject>MiniPlayer.Program</StartupObject>
    <!-- DPI comes from app.manifest (WPF app; WinForms only used for the tray icon) -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Self-contained publish, packed into an installer by release.ps1 (Velopack) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Microsoft Store build: dotnet publish -c Release -p:StoreBuild=true (see store/build-store.ps1) -->
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF/WinForms type name clashes (Application, Button, ...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
