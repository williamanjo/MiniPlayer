<!-- The installer: one card (hero art + panel) going through Setup → Installing → Done. -->
<Window x:Class="MiniPlayerSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MiniPlayer.Views"
        Title="MiniPlayer for Browser Music" Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="800" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#16141E">
    <Window.Resources>
        <ResourceDictionary Source="SetupStyles.xaml" />
    </Window.Resources>

    <Grid Margin="20,16,20,28">
        <!-- shadow on its own layer; the card is clipped to its corners -->
        <Border CornerRadius="14" Background="#FBF7FE">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.5" /></Border.Effect>
        </Border>
        <Grid v:RoundedClip.CornerRadius="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="Hero" Height="300" Stretch="UniformToFill" MouseLeftButtonDown="OnDrag" RenderOptions.BitmapScalingMode="HighQuality" />
            <Button x:Name="CloseButton" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                    Content="✕" FontSize="13" Cursor="Hand" Click="OnClose">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Background="#1416141E"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2916141E" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Grid.Row="1" Padding="26,20,26,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F6F1FD" Offset="0" />
                        <GradientStop Color="#FDF2F8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- 1. choices -->
                    <StackPanel x:Name="PageSetup">
                        <TextBlock x:Name="SetupTitle" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="SetupLead" Style="{StaticResource Lead}" />
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}" IsChecked="True" Margin="0,0,6,0">
                                <StackPanel><TextBlock x:Name="StartupText" FontWeight="SemiBold" /><TextBlock x:Name="StartupHint" FontSize="12.5" Foreground="{StaticResource Muted}" /></StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="UpdateBox" Style="{StaticResource Switch}" IsChecked="True" Margin="6,0,0,0">
                                <StackPanel><TextBlock x:Name="UpdateText" FontWeight="SemiBold" /><TextBlock x:Name="UpdateHint" FontSize="12.5" Foreground="{StaticResource Muted}" /></StackPanel>
                            </CheckBox>
                        </UniformGrid>

                        <StackPanel x:Name="OldPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <Border Height="1" Background="#DCCFF3" Margin="0,0,0,12" />
                            <TextBlock x:Name="OldTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel x:Name="Chips" Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="KeepChoice" Style="{StaticResource Choice}" GroupName="old" IsChecked="True" Tag="#7C3AED" Margin="0,0,6,0" Checked="OnChoice">
                                    <StackPanel><TextBlock x:Name="KeepText" FontWeight="SemiBold" /><TextBlock x:Name="KeepHint" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FreshChoice" Style="{StaticResource Choice}" GroupName="old" Tag="#E11D48" Margin="6,0,0,0" Checked="OnChoice">
                                    <StackPanel><TextBlock x:Name="FreshText" FontWeight="SemiBold" /><TextBlock x:Name="FreshHint" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <CheckBox x:Name="BackupBox" IsChecked="True" Margin="4,10,0,0" Visibility="Collapsed" VerticalContentAlignment="Center">
                                <TextBlock x:Name="BackupText" FontSize="13" />
                            </CheckBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button x:Name="CancelButton" Style="{StaticResource Button}" Click="OnClose" Margin="0,0,10,0" />
                            <Button x:Name="InstallButton" Style="{StaticResource Primary}" Click="OnInstall" IsDefault="True" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 2. installing -->
                    <StackPanel x:Name="PageProgress" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" IsIndeterminate="True" />
                        <StackPanel x:Name="Steps" Margin="0,14,0,0" />
                    </StackPanel>

                    <!-- 3. done -->
                    <StackPanel x:Name="PageDone" Visibility="Collapsed">
                        <TextBlock x:Name="DoneTitle" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="DoneLead" Style="{StaticResource Lead}" />
                        <StackPanel x:Name="ThemePanel">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="ThemeHint" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="ThemeTitle" FontWeight="SemiBold" />
                            </DockPanel>
                            <ListBox x:Name="ThemeList" Style="{StaticResource Themes}" Margin="0,0,0,10" />
                        </StackPanel>
                        <DockPanel>
                            <Button x:Name="FinishButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="OnFinish" IsDefault="True" />
                            <CheckBox x:Name="OpenBox" IsChecked="True" VerticalAlignment="Center" VerticalContentAlignment="Center">
                                <TextBlock x:Name="OpenText" />
                            </CheckBox>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
