<Application x:Class="MiniPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniPlayer.Localization"
             xmlns:views="clr-namespace:MiniPlayer.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:FractionConverter x:Key="FractionConverter" />
        <views:MinSizeToVisibilityConverter x:Key="MinSizeToVis" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Theme tokens: defaults here, replaced at runtime by ThemeService -->
        <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
        <SolidColorBrush x:Key="ThemeBackground" Color="#F21F1F1F" />
        <SolidColorBrush x:Key="ThemeBorder" Color="#33FFFFFF" />
        <Thickness x:Key="ThemeBorderThickness">1</Thickness>
        <CornerRadius x:Key="ThemeCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="ThemeCoverRadius">6</CornerRadius>
        <SolidColorBrush x:Key="ThemeForeground" Color="White" />
        <SolidColorBrush x:Key="ThemeSecondary" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="ThemeTrack" Color="#40808080" />
        <SolidColorBrush x:Key="ThemeHover" Color="#33808080" />
        <FontFamily x:Key="ThemeFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <DropShadowEffect x:Key="ThemeShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
        <Visibility x:Key="ThemeCoverBackdropVisibility">Collapsed</Visibility>
        <SolidColorBrush x:Key="ThemeImageBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ThemeOverlay" Color="Transparent" />
        <FontFamily x:Key="ThemeTitleFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <sys:Double x:Key="ThemeTitleSize">14</sys:Double>
        <sys:Double x:Key="ThemeTitleSizeLarge">16</sys:Double>
        <sys:Double x:Key="ThemeTitleSizeSmall">13</sys:Double>
        <FontWeight x:Key="ThemeTitleWeight">SemiBold</FontWeight>
        <sys:Double x:Key="ThemeSubtitleSize">12</sys:Double>
        <SolidColorBrush x:Key="ThemeLyrics" Color="White" />
        <SolidColorBrush x:Key="ThemeLyricsDim" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="ThemeIcon" Color="White" />
        <SolidColorBrush x:Key="ThemePlayBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ThemePlayForeground" Color="White" />
        <CornerRadius x:Key="ThemePlayCorner">5</CornerRadius>
        <sys:Double x:Key="ThemePlaySize">44</sys:Double>
        <SolidColorBrush x:Key="ThemeCoverBorder" Color="Transparent" />
        <Thickness x:Key="ThemeCoverBorderThickness">0</Thickness>
        <SolidColorBrush x:Key="ThemeProgress" Color="#60CDFF" />
        <sys:Double x:Key="ThemeProgressHeight">4</sys:Double>
        <SolidColorBrush x:Key="ThemeVisualizer" Color="#60CDFF" />
        <sys:Double x:Key="ThemeVisualizerOpacity">0.85</sys:Double>
        <sys:Double x:Key="ThemeImageOpacity">1</sys:Double>
        <Visibility x:Key="ThemeCreditVisibility">Visible</Visibility>
        <Visibility x:Key="ThemeCreditCoverVisibility">Collapsed</Visibility>
        <VerticalAlignment x:Key="ThemeCreditVertical">Bottom</VerticalAlignment>
        <HorizontalAlignment x:Key="ThemeCreditHorizontal">Center</HorizontalAlignment>
        <Thickness x:Key="ThemeCreditMargin">0,0,0,1</Thickness>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemeHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55808080" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShuffleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="ToolTip" Value="{l:Tr tip_shuffle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShuffleOn}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RepeatButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="ToolTip" Value="{l:Tr tip_repeat}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RepeatOn}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LyricsButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="ToolTip" Value="{l:Tr tip_lyrics}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowLyrics}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE718;" />
            <Setter Property="ToolTip" Value="{l:Tr menu_pin}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PinOnTop}" Value="True">
                    <Setter Property="Content" Value="&#xE840;" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="ToolTip" Value="{l:Tr tip_pinned}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Play/pause: plain icon, or icon on a filled circle (theme "playButton": "circle") -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="{DynamicResource ThemePlaySize}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource ThemePlayBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePlayForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ThemePlayCorner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeProgress}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource ThemeTrack}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
